# Development URL only. This is NOT an official RIOGINEER domain.
SITE_URL=http://localhost:3000
# Keep false for local development and preview deployments.
# Enable only with an approved public HTTPS domain and release-ready content.
SITE_INDEXABLE=false
# No email provider, delivery credentials, analytics, or verification IDs are configured.
# Future secrets belong only in .env.local or hosting environment settings.

# Digital Engineer: authoritative local Python engine.
RIOGINEER_ENGINE_URL=http://127.0.0.1:8001

# Specification interpretation is disabled until ALL four variables below are set.
# Server-only. Never prefix credentials with NEXT_PUBLIC_.
RIOGINEER_LLM_PROVIDER=
RIOGINEER_LLM_ENDPOINT=
RIOGINEER_LLM_MODEL=
RIOGINEER_LLM_API_KEY=
# Example adapter: RIOGINEER_LLM_PROVIDER=chat-completions
# Endpoint must be a full HTTPS Chat Completions URL supplied by your chosen provider.
# For OpenAI: https://api.openai.com/v1/chat/completions
# Choose a provider model supporting JSON object output; there is no default model.

# Optional absolute path to Python with interpretation/requirements.txt installed.
# Defaults to python3 on PATH. Set this when using the project virtual environment.
# RIOGINEER_PDF_PYTHON=/absolute/path/to/python

# Optional signing secret (at least 32 random bytes recommended).
# Without this, a process-lifetime random key is used; restart requires reinterpretation.
# Set a consistent secret when using more than one local server worker.
# RIOGINEER_REVIEW_SECRET=
