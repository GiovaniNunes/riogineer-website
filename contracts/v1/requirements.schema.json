{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "requirements"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "profile": {
      "type": "string",
      "const": "single_separator_development"
    },
    "units": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "string",
          "const": "K"
        },
        "pressure": {
          "type": "string",
          "const": "Pa_abs"
        },
        "component_mass_flow": {
          "type": "string",
          "const": "kg/h"
        },
        "heat_capacity": {
          "type": "string",
          "const": "J/(kg K)"
        },
        "duty": {
          "type": "string",
          "const": "W"
        },
        "recovery": {
          "type": "string",
          "const": "mass_fraction"
        }
      },
      "required": [
        "temperature",
        "pressure",
        "component_mass_flow",
        "heat_capacity",
        "duty",
        "recovery"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "const": "synthetic_development_assumptions"
        }
      },
      "required": [
        "source",
        "basis"
      ],
      "additionalProperties": false
    },
    "components": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
      }
    },
    "feeds": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "state": {
            "type": "object",
            "properties": {
              "temperature_K": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pressure_Pa_abs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "component_mass_flow_kg_h": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "required": [
              "temperature_K",
              "pressure_Pa_abs",
              "component_mass_flow_kg_h"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "equipment": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "type": {
            "type": "string",
            "const": "three_phase_separator"
          },
          "model": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "const": "prescribed_component_recoveries"
              },
              "version": {
                "type": "string",
                "const": "1.0"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object",
            "properties": {
              "separator": {
                "type": "object",
                "properties": {
                  "temperature_K": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "pressure_Pa_abs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "thermal_mode": {
                    "type": "string",
                    "const": "specified_temperature_calculate_duty"
                  }
                },
                "required": [
                  "temperature_K",
                  "pressure_Pa_abs",
                  "thermal_mode"
                ],
                "additionalProperties": false
              },
              "recovery_fractions": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "gas": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "oil": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "water": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "gas",
                    "oil",
                    "water"
                  ],
                  "additionalProperties": false
                }
              },
              "caloric_model": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "constant_cp_no_pressure_or_phase_dependence"
                  },
                  "reference_temperature_K": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cp_J_kg_K": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "required": [
                  "type",
                  "reference_temperature_K",
                  "cp_J_kg_K"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "separator",
              "recovery_fractions",
              "caloric_model"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "model",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "required_outputs": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "streams"
        },
        {
          "type": "string",
          "const": "mass_balance"
        },
        {
          "type": "string",
          "const": "energy_balance"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "profile",
    "units",
    "provenance",
    "components",
    "feeds",
    "equipment",
    "required_outputs"
  ],
  "additionalProperties": false
}
